{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport asyncio\n\nasync def child():\n    try:\n        await asyncio.sleep(10)\n    finally:\n        print('child cleanup start')\n        await asyncio.sleep(0.1)\n        print('child cleanup end')\n\nasync def main():\n    t = asyncio.create_task(child())\n    await asyncio.sleep(0.1)\n    try:\n        await asyncio.sleep(10)\n    except asyncio.CancelledError:\n        print('caught cancel in main')\n        t.cancel()\n        try:\n            await asyncio.gather(t, return_exceptions=True)\n            print('gather returned')\n        except BaseException as e:\n            print('gather raised', type(e), e)\n        raise\n\nasync def driver():\n    m = asyncio.create_task(main())\n    await asyncio.sleep(0.2)\n    m.cancel()\n    try:\n        await m\n    except BaseException as e:\n        print('driver saw', type(e), e)\n\nasyncio.run(driver())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
