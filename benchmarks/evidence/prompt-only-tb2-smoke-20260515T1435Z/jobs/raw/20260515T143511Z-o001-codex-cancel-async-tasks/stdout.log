{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"ls -la codex/app && sed -n '1,200p' codex/app/run.py\"","aggregated_output":"total 12\ndrwxr-xr-x 2 argustest argustest 4096 May 15 14:36 .\ndrwxrwxr-x 3 argustest argustest 4096 May 15 14:35 ..\n-rw-rw-r-- 1 argustest argustest 1084 May 15 14:36 run.py\nimport asyncio\nfrom collections.abc import Awaitable, Callable\n\n\nasync def run_tasks(\n    tasks: list[Callable[[], Awaitable[None]]], max_concurrent: int\n) -> None:\n    \"\"\"Run async jobs with a concurrency cap and wait for cancellation cleanup.\"\"\"\n    if max_concurrent < 1:\n        raise ValueError(\"max_concurrent must be at least 1\")\n    if not tasks:\n        return\n\n    remaining_tasks = iter(tasks)\n    remaining_tasks_lock = asyncio.Lock()\n    no_more_tasks = object()\n\n    async def worker() -> None:\n        while True:\n            async with remaining_tasks_lock:\n                task_factory = next(remaining_tasks, no_more_tasks)\n\n            if task_factory is no_more_tasks:\n                return\n\n            await task_factory()\n\n    workers = [\n        asyncio.create_task(worker())\n        for _ in range(min(max_concurrent, len(tasks)))\n    ]\n\n    try:\n        await asyncio.gather(*workers)\n    except BaseException:\n        for worker_task in workers:\n            worker_task.cancel()\n        await asyncio.gather(*workers, return_exceptions=True)\n        raise\n","exit_code":0,"status":"completed"}}
