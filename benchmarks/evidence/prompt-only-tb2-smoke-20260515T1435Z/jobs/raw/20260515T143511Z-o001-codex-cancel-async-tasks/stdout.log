{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"docker exec -w /app tb2-codex-cancel-async-tasks-20260515143528-3448301 python - <<'PY'\nimport asyncio\nimport signal\nfrom run import run_tasks\n\n\nasync def test_concurrency_limit():\n    current = 0\n    max_seen = 0\n    completed = []\n\n    def make_task(index):\n        async def task():\n            nonlocal current, max_seen\n            current += 1\n            max_seen = max(max_seen, current)\n            await asyncio.sleep(0.05)\n            completed.append(index)\n            current -= 1\n        return task\n\n    await run_tasks([make_task(i) for i in range(6)], 2)\n    assert sorted(completed) == list(range(6)), completed\n    assert max_seen == 2, max_seen\n\n\nasync def test_manual_cancellation_waits_for_cleanup():\n    started = 0\n    cleanup = []\n    start_gate = asyncio.Event()\n\n    def make_task(index):\n        async def task():\n            nonlocal started\n            started += 1\n            if started >= 2:\n                start_gate.set()\n            try:\n                await asyncio.sleep(10)\n            finally:\n                await asyncio.sleep(0.05)\n                cleanup.append(index)\n        return task\n\n    runner = asyncio.create_task(run_tasks([make_task(i) for i in range(4)], 2))\n    await start_gate.wait()\n    runner.cancel()\n\n    try:\n        await runner\n    except asyncio.CancelledError:\n        pass\n    else:\n        raise AssertionError('run_tasks should propagate cancellation')\n\n    assert sorted(cleanup) == [0, 1], cleanup\n\n\nasync def test_failure_cancels_other_workers_and_waits_for_cleanup():\n    cleanup = []\n    started = asyncio.Event()\n\n    async def failing_task():\n        started.set()\n        await asyncio.sleep(0.02)\n        raise RuntimeError('boom')\n\n    async def sibling_task():\n        await started.wait()\n        try:\n            await asyncio.sleep(10)\n        finally:\n            await asyncio.sleep(0.05)\n            cleanup.append('sibling-cleanup')\n\n    try:\n        await run_tasks([failing_task, sibling_task], 2)\n    except RuntimeError as exc:\n        assert str(exc) == 'boom'\n    else:\n        raise AssertionError('run_tasks should propagate task exceptions')\n\n    assert cleanup == ['sibling-cleanup'], cleanup\n\n\nasync def test_validation():\n    try:\n        await run_tasks([], 0)\n    except ValueError as exc:\n        assert 'max_concurrent' in str(exc)\n    else:\n        raise AssertionError('expected ValueError for invalid max_concurrent')\n\n\nasync def run_async_tests():\n    await test_concurrency_limit()\n    await test_manual_cancellation_waits_for_cleanup()\n    await test_failure_cancels_other_workers_and_waits_for_cleanup()\n    await test_validation()\n\n\ncleanup_after_sigint = []\n\nasync def sigint_task():\n    try:\n        await asyncio.sleep(10)\n    finally:\n        await asyncio.sleep(0.05)\n        cleanup_after_sigint.append('done')\n\n\nasyncio.run(run_async_tests())\n\ntry:\n    async def main_with_sigint():\n        loop = asyncio.get_running_loop()\n        loop.call_later(0.05, lambda: signal.raise_signal(signal.SIGINT))\n        await run_tasks([sigint_task], 1)\n\n    asyncio.run(main_with_sigint())\nexcept KeyboardInterrupt:\n    assert cleanup_after_sigint == ['done'], cleanup_after_sigint\nelse:\n    raise AssertionError('expected KeyboardInterrupt from SIGINT')\n\nprint('all checks passed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
