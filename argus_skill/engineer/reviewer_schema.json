{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["done", "continue", "blocked"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "round_summary_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "completion_summary_markdown": {
      "type": "string",
      "maxLength": 5000
    },
    "failure_cause": {
      "type": ["string", "null"],
      "enum": [
        "skill_gap",
        "execution_mistake",
        "ambiguous_objective",
        "environmental",
        "method_failure",
        "unknown",
        "",
        null
      ]
    },
    "mission_lesson": {
      "type": ["string", "null"],
      "maxLength": 4000
    },
    "process_lesson": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "scope": {
      "type": ["string", "null"],
      "enum": ["bounded", "final_submission", null]
    },
    "planner_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forward_progress": { "type": "boolean" },
        "headline": { "type": "string", "maxLength": 600 },
        "blocker": { "type": "string", "maxLength": 1200 },
        "recommended_next": { "type": "string", "maxLength": 1200 },
        "evidence_files": {
          "type": ["array", "null"],
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "maxLength": 400 },
              "why": { "type": "string", "maxLength": 600 }
            },
            "required": ["path", "why"]
          }
        }
      },
      "required": ["forward_progress", "headline", "blocker", "recommended_next", "evidence_files"]
    },
    "checklist": {
      "type": ["array", "null"],
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "maxLength": 500 },
          "satisfied": { "type": "boolean" },
          "evidence": { "type": "string", "maxLength": 2000 }
        },
        "required": ["item", "satisfied", "evidence"]
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goal": { "type": "string", "maxLength": 400 },
        "done": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "maxLength": 280 }
        },
        "tried_and_failed": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string", "maxLength": 280 }
        },
        "open_blocker": { "type": "string", "maxLength": 800 },
        "next_step": { "type": "string", "maxLength": 600 }
      },
      "required": ["goal", "done", "tried_and_failed", "open_blocker", "next_step"]
    }
  },
  "required": [
    "status",
    "confidence",
    "reason",
    "next_action",
    "round_summary_markdown",
    "completion_summary_markdown",
    "failure_cause",
    "mission_lesson",
    "process_lesson",
    "scope",
    "planner_report",
    "checklist",
    "checkpoint"
  ]
}
