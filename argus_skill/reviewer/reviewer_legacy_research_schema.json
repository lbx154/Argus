{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Read-only compatibility schema for pre-research-contract reviewer output.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "continue",
        "blocked"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "operator_question": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "round_summary_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "completion_summary_markdown": {
      "type": "string",
      "maxLength": 5000
    },
    "achievement": {
      "type": [
        "object",
        "null"
      ],
      "description": "Verified project-level achievement only; otherwise null.",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "metric_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "required": [
        "title",
        "goal",
        "metric_id",
        "summary",
        "evidence"
      ]
    },
    "failure_cause": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "skill_gap",
        "execution_mistake",
        "ambiguous_objective",
        "environmental",
        "method_failure",
        "unknown",
        "",
        null
      ]
    },
    "scope": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "bounded",
        "final_submission",
        null
      ]
    },
    "math_result": {
      "type": [
        "object",
        "null"
      ],
      "description": "Legacy Math assessment compatibility field.",
      "additionalProperties": false,
      "properties": {
        "result_class": {
          "type": "string",
          "enum": [
            "known_result",
            "finite_verification",
            "counterexample",
            "partial_result",
            "new_candidate",
            "novelty_unverified",
            "verified_new_result"
          ]
        },
        "correctness": {
          "type": "string",
          "enum": [
            "verified",
            "incorrect",
            "uncertain"
          ]
        },
        "novelty": {
          "type": "string",
          "enum": [
            "known",
            "unverified",
            "verified_new",
            "not_applicable"
          ]
        },
        "statement_fidelity": {
          "type": "string",
          "enum": [
            "verified",
            "failed",
            "uncertain"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "required": [
        "result_class",
        "correctness",
        "novelty",
        "statement_fidelity",
        "evidence",
        "limitations"
      ]
    },
    "planner_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forward_progress": {
          "type": "boolean"
        },
        "headline": {
          "type": "string",
          "maxLength": 600
        },
        "blocker": {
          "type": "string",
          "maxLength": 1200
        },
        "recommended_next": {
          "type": "string",
          "maxLength": 1200
        },
        "plan_signal": {
          "type": "string",
          "enum": [
            "continue",
            "reconsider"
          ]
        },
        "plan_signal_reason": {
          "type": "string",
          "maxLength": 1200
        },
        "evidence_files": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 400
              },
              "why": {
                "type": "string",
                "maxLength": 600
              }
            },
            "required": [
              "path",
              "why"
            ]
          }
        }
      },
      "required": [
        "forward_progress",
        "headline",
        "blocker",
        "recommended_next",
        "plan_signal",
        "plan_signal_reason",
        "evidence_files"
      ]
    },
    "checklist": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string",
            "maxLength": 500
          },
          "satisfied": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "item",
          "satisfied",
          "evidence"
        ]
      }
    },
    "checklist_feedback": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Planner-only checklist correction feedback; otherwise null.",
      "properties": {
        "stage": {
          "type": "string",
          "maxLength": 100
        },
        "summary": {
          "type": "string",
          "maxLength": 600
        },
        "items": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 200
              },
              "problem": {
                "type": "string",
                "maxLength": 600
              },
              "suggested_fix": {
                "type": "string",
                "maxLength": 600
              }
            },
            "required": [
              "id",
              "problem",
              "suggested_fix"
            ]
          }
        }
      },
      "required": [
        "stage",
        "summary",
        "items"
      ]
    },
    "step_back": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Required for any measured result; null only when nothing was measured.",
      "properties": {
        "supported_by_results": {
          "type": "string",
          "enum": [
            "yes",
            "partial",
            "no"
          ]
        },
        "surprises": {
          "type": "string",
          "maxLength": 1200
        },
        "new_questions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 400
          }
        },
        "alt_directions": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "direction": {
                "type": "string",
                "maxLength": 500
              },
              "why": {
                "type": "string",
                "maxLength": 500
              },
              "cheap_to_test": {
                "type": "boolean"
              }
            },
            "required": [
              "direction",
              "why",
              "cheap_to_test"
            ]
          }
        }
      },
      "required": [
        "supported_by_results",
        "surprises",
        "new_questions",
        "alt_directions"
      ]
    }
  },
  "required": [
    "status",
    "reason",
    "next_action",
    "operator_question",
    "round_summary_markdown",
    "completion_summary_markdown",
    "achievement",
    "failure_cause",
    "scope",
    "math_result",
    "planner_report",
    "checklist",
    "checklist_feedback",
    "step_back"
  ]
}
