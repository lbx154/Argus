{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "continue",
        "blocked",
        "replan_requested",
        "research_incomplete",
        "paused_no_breakthrough",
        "exhausted_current_methods"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "operator_question": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "achievement": {
      "type": [
        "object",
        "null"
      ],
      "description": "Verified project-level achievement only; otherwise null.",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "metric_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "required": [
        "title",
        "goal",
        "metric_id",
        "summary",
        "evidence"
      ]
    },
    "failure_cause": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "skill_gap",
        "execution_mistake",
        "ambiguous_objective",
        "environmental",
        "method_failure",
        "unknown",
        "",
        null
      ]
    },
    "failure_source": {
      "type": ["object", "null"],
      "description": "Acceptance failure source with concrete evidence; null when no acceptance failure was diagnosed.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "validator_defect",
            "provenance_binding_defect",
            "infrastructure_failure",
            "scientific_evidence_failure"
          ]
        },
        "validator_id": {"type": ["string", "null"], "maxLength": 200},
        "repair_paths": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 500},
          "description": "Exact project-relative validator/test/provenance paths that a restricted repair may edit; empty unless the diagnosed defect is repairable without changing scientific evidence."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "artifact": {"type": "string", "minLength": 1, "maxLength": 500},
              "observation": {"type": "string", "minLength": 1, "maxLength": 1000}
            },
            "required": ["artifact", "observation"]
          }
        }
      },
      "required": ["kind", "validator_id", "repair_paths", "evidence"]
    },
    "scientific_decision": {
      "type": ["string", "null"],
      "enum": ["go", "pivot", "no_go", "undecided", null]
    },
    "failure_layer": {
      "type": ["string", "null"],
      "enum": [
        "platform",
        "orchestration",
        "evaluator",
        "evidence_packaging",
        "scientific",
        "operator",
        "unknown",
        "",
        null
      ]
    },
    "progress_class": {
      "type": "string",
      "enum": [
        "decision",
        "evidence",
        "setup_only",
        "artifact_sync_only",
        "none"
      ]
    },
    "control": {
      "type": [
        "object",
        "null"
      ],
      "description": "OPTIONAL reviewer-authored runner control. Use null unless you are explicitly requesting a reviewed wait on a healthy self-watched subagent.",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "wait_for_subagent",
            null
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      },
      "required": [
        "action",
        "task_id"
      ]
    },
    "scope": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "bounded",
        "final_submission",
        null
      ]
    },
    "research_result": {
      "type": [
        "object",
        "null"
      ],
      "description": "Assessment for a persisted research target; otherwise null.",
      "additionalProperties": false,
      "properties": {
        "result_class": {
          "type": "string",
          "enum": [
            "known_result",
            "finite_verification",
            "counterexample",
            "partial_result",
            "new_candidate",
            "novelty_unverified",
            "verified_new_result",
            "structured_failure_report",
            "honest_final_report",
            "literature_review",
            "lean_local_verification",
            "complete_solution",
            "new_theorem",
            "improved_bound",
            "new_infinite_family",
            "new_reduction",
            "exact_counterexample",
            "exhausted_current_methods"
          ]
        },
        "correctness_status": {
          "type": "string",
          "enum": [
            "verified",
            "incorrect",
            "uncertain"
          ]
        },
        "novelty_status": {
          "type": "string",
          "enum": [
            "known",
            "unverified",
            "verified_new",
            "not_applicable"
          ]
        },
        "statement_fidelity_status": {
          "type": "string",
          "enum": [
            "verified",
            "failed",
            "uncertain",
            "not_applicable"
          ]
        },
        "significance_status": {
          "type": "string",
          "enum": [
            "exploratory",
            "publishable",
            "doctoral",
            "unverified",
            "not_applicable"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "required": [
        "result_class",
        "correctness_status",
        "novelty_status",
        "statement_fidelity_status",
        "significance_status",
        "evidence",
        "limitations"
      ]
    },
    "planner_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forward_progress": {
          "type": "boolean"
        },
        "plan_signal": {
          "type": "string",
          "enum": [
            "continue",
            "reconsider"
          ]
        },
        "evidence_files": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 400
              },
              "why": {
                "type": "string",
                "maxLength": 600
              }
            },
            "required": [
              "path",
              "why"
            ]
          }
        }
      },
      "required": [
        "forward_progress",
        "plan_signal",
        "evidence_files"
      ]
    },
    "checklist": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string",
            "maxLength": 500
          },
          "satisfied": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "item",
          "satisfied",
          "evidence"
        ]
      }
    },
    "checklist_feedback": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Planner-only checklist correction feedback; otherwise null.",
      "properties": {
        "stage": {
          "type": "string",
          "maxLength": 100
        },
        "summary": {
          "type": "string",
          "maxLength": 600
        },
        "items": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 200
              },
              "problem": {
                "type": "string",
                "maxLength": 600
              },
              "suggested_fix": {
                "type": "string",
                "maxLength": 600
              }
            },
            "required": [
              "id",
              "problem",
              "suggested_fix"
            ]
          }
        }
      },
      "required": [
        "stage",
        "summary",
        "items"
      ]
    }
  },
  "required": [
    "status",
    "reason",
    "next_action",
    "operator_question",
    "achievement",
    "failure_cause",
    "failure_source",
    "scientific_decision",
    "failure_layer",
    "progress_class",
    "control",
    "scope",
    "research_result",
    "planner_report",
    "checklist",
    "checklist_feedback"
  ]
}
