{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "done",
        "continue",
        "blocked",
        "replan_requested"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "next_action": {
      "type": "string",
      "maxLength": 1500
    },
    "operator_question": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "achievement": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "metric_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "required": [
        "title",
        "goal",
        "metric_id",
        "summary",
        "evidence"
      ]
    },
    "failure_cause": {
      "enum": [
        "skill_gap",
        "execution_mistake",
        "ambiguous_objective",
        "environmental",
        "method_failure",
        "unknown",
        "",
        null
      ]
    },
    "failure_source": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "validator_defect",
            "provenance_binding_defect",
            "infrastructure_failure",
            "scientific_evidence_failure"
          ]
        },
        "validator_id": {"type": ["string", "null"]},
        "repair_paths": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "artifact": {"type": "string"},
              "observation": {"type": "string"}
            },
            "required": ["artifact", "observation"]
          }
        }
      },
      "required": ["kind", "validator_id", "repair_paths", "evidence"]
    },
    "scientific_decision": {
      "enum": ["continue", "redirect", "stop", "uncertain", null]
    },
    "failure_layer": {
      "enum": [
        "platform",
        "orchestration",
        "evaluator",
        "evidence_packaging",
        "scientific",
        "operator",
        "unknown",
        "",
        null
      ]
    },
    "progress_class": {
      "enum": [
        "decision",
        "evidence",
        "setup_only",
        "artifact_sync_only",
        "none"
      ]
    },
    "control": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "wait_for_subagent",
            null
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      },
      "required": [
        "action",
        "task_id"
      ]
    },
    "scope": {
      "enum": [
        "bounded",
        "final_submission",
        null
      ]
    },
    "routing_decision": {
      "enum": [
        "",
        "keep_mission",
        "return_to_planner"
      ]
    },
    "routing_reason": {
      "type": "string",
      "maxLength": 1000
    },
    "routing_handoff": {
      "type": "string",
      "maxLength": 1000
    },
    "planner_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forward_progress": {
          "type": "boolean"
        },
        "plan_signal": {
          "enum": [
            "continue",
            "reconsider"
          ]
        },
        "evidence_files": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 400
              },
              "why": {
                "type": "string",
                "maxLength": 600
              }
            },
            "required": [
              "path",
              "why"
            ]
          }
        }
      },
      "required": [
        "forward_progress",
        "plan_signal",
        "evidence_files"
      ]
    },
    "checklist": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string",
            "maxLength": 500
          },
          "satisfied": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "item",
          "satisfied",
          "evidence"
        ]
      }
    },
    "certification_payload": {
      "type": [
        "object",
        "null"
      ],
      "description": "Reviewer-authored framework certification payload; null unless the objective requires a consumed handoff review object with per-checklist verdicts.",
      "additionalProperties": false,
      "properties": {
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "done"
              ]
            },
            "scope": {
              "enum": [
                "bounded",
                "final_submission"
              ]
            },
            "correctness_status": {
              "enum": [
                "verified",
                "incorrect",
                "uncertain"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "next_action": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1500
            },
            "blocking_issues": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "checklist": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "checklist_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "verdict": {
                    "enum": [
                      "supported",
                      "not_applicable"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                      "type": "string",
                      "maxLength": 400
                    }
                  },
                  "reviewer_notes": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": [
                  "checklist_id",
                  "verdict",
                  "evidence_refs",
                  "reviewer_notes"
                ]
              }
            }
          },
          "required": [
            "status",
            "scope",
            "correctness_status",
            "summary",
            "next_action",
            "blocking_issues",
            "checklist"
          ]
        }
      },
      "required": [
        "review"
      ]
    },
    "checklist_feedback": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "string",
          "maxLength": 100
        },
        "summary": {
          "type": "string",
          "maxLength": 600
        },
        "items": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 200
              },
              "problem": {
                "type": "string",
                "maxLength": 600
              },
              "suggested_fix": {
                "type": "string",
                "maxLength": 600
              }
            },
            "required": [
              "id",
              "problem",
              "suggested_fix"
            ]
          }
        }
      },
      "required": [
        "stage",
        "summary",
        "items"
      ]
    }
  },
  "required": [
    "status",
    "reason",
    "next_action",
    "operator_question",
    "achievement",
    "failure_cause",
    "failure_source",
    "scientific_decision",
    "failure_layer",
    "progress_class",
    "control",
    "scope",
    "routing_decision",
    "routing_reason",
    "routing_handoff",
    "planner_report",
    "checklist",
    "certification_payload",
    "checklist_feedback"
  ]
}
