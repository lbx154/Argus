{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "done",
        "continue",
        "blocked",
        "replan_requested"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "next_action": {
      "type": "string",
      "maxLength": 1500
    },
    "operator_question": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    }
  },
  "required": [
    "status",
    "reason",
    "next_action",
    "operator_question"
  ]
}
