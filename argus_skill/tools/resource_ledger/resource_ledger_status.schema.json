{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schemas/resource-ledger-status.v1.json",
  "title": "ResourceStatus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enforcement",
    "accelerators",
    "holders",
    "queue"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "enforcement": {
      "enum": [
        "strict",
        "advisory"
      ]
    },
    "accelerators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResourceAcceleratorStatus"
      }
    },
    "holders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResourceHolderStatus"
      }
    },
    "queue": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResourceQueueStatus"
      }
    }
  },
  "$defs": {
    "ResourceAcceleratorStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "device_count",
        "detail"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "absent",
            "inaccessible",
            "degraded"
          ]
        },
        "device_count": {
          "type": "integer",
          "minimum": 0
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "ResourceYieldResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason"
      ],
      "properties": {
        "decision": {
          "enum": [
            "decline",
            "yield"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "ResourceYieldRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "response"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceYieldResponse"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ResourceHolderStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "task_id",
        "intent",
        "ttl_seconds",
        "device_count",
        "yield_requests"
      ],
      "properties": {
        "project": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "ttl_seconds": {
          "type": "number",
          "minimum": 0
        },
        "device_count": {
          "type": "integer",
          "minimum": 0
        },
        "yield_requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceYieldRequest"
          }
        }
      }
    },
    "ResourceQueueStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "project",
        "task_id",
        "intent",
        "ttl_seconds"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "project": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "ttl_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
