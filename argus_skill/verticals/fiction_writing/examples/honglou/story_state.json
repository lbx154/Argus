  "world_rules": [
    {
      "id": "r_daguan",
      "statement": "众姊妹居大观园：黛玉潇湘馆、宝钗蘅芜苑、宝玉怡红院。"
    },
    {
      "id": "r_jiabin",
      "statement": "黛玉母贾敏已故，黛玉自幼寄居外祖母贾母膝下。"
    },
    {
      "id": "r_ning_rong",
      "statement": "贾府两支：宁国府（长房）、荣国府（次房）；宝玉一房居荣府。"
    },
    {
      "id": "r_sanchun",
      "statement": "贾府三春：迎春（赦之女）、探春（政庶女）、惜春（宁府敬之女）。"
    },
    {
      "id": "r_jinling",
      "statement": "金陵十二钗正册：黛玉、宝钗、元春、探春、湘云、妙玉、迎春、惜春、凤姐、巧姐、李纨、可卿。"
    }
  ],
