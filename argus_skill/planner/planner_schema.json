{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_done",
    "reason",
    "restart_daemon",
    "restart_reason",
    "waiting",
    "waiting_reason",
    "new_tasks",
    "meta_decision"
  ],
  "properties": {
    "project_done": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "restart_daemon": {
      "type": "boolean"
    },
    "restart_reason": {
      "type": "string"
    },
    "waiting": {
      "type": "boolean"
    },
    "waiting_reason": {
      "type": "string"
    },
    "new_tasks": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "impact_score",
          "impact_area",
          "evidence",
          "scope",
          "objective"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "impact_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "impact_area": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "operator_ux",
              "performance",
              "reliability",
              "integration",
              "requirement_gap",
              "discovery"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "enum": [
              "bounded",
              "final_submission"
            ]
          },
          "objective": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "meta_decision": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "OPTIONAL — only on a meta-control jump/explore turn. Your OWN call about the search regime (the harness convened the turn on a counter but does not decide for you). The harness records it and re-surfaces your declared forbidden directions next cycle as visibility; it does NOT hard-gate or reject your next candidate. Emit null if you have nothing to declare.",
      "required": [
        "mode",
        "confidence",
        "reasoning",
        "strategy_type",
        "forbidden"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["explore", "exploit", "jump"] },
        "confidence": { "type": "number" },
        "reasoning": { "type": "string" },
        "strategy_type": { "type": "string" },
        "forbidden": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
