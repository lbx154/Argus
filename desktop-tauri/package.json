{
  "name": "argus-desktop-tauri",
  "version": "1.0.0",
  "private": true,
  "description": "Argus desktop host for macOS and Windows",
  "author": "lbx154",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ui:dev": "vite --config vite.config.ts",
    "ui:build": "vite build --config vite.config.ts",
    "ui:typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "test:copy": "node --test tests/verified-copy.node.mjs",
    "test:release": "node --test tests/windows-release.node.mjs tests/preview-identity.node.mjs",
    "dev": "tauri dev --config src-tauri/tauri.conf.json",
    "build": "node scripts/desktop-build.mjs build",
    "build:unsigned": "node scripts/desktop-build.mjs unsigned",
    "build:debug": "npm run build:argus && tauri build --debug --config src-tauri/tauri.conf.json --bundles nsis",
    "build:argus": "node scripts/desktop-build.mjs argus",
    "build:preview": "node scripts/desktop-preview.mjs",
    "build:portable": "node scripts/desktop-portable.mjs",
    "test:portable": "node --test tests/portable-preview.node.mjs tests/upgrade-contract.node.mjs",
    "prepare:node": "node scripts/prepare-node-runtime.mjs",
    "test:rust": "cargo check --manifest-path src-tauri/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml --lib --test core_tests",
    "test": "npm run ui:typecheck && npm run test:copy && npm run test:release && npm run test:ui && npm run test:rust",
    "dist": "node scripts/desktop-build.mjs dist",
    "update:generate-key": "tauri signer generate -w .keys/argus-updater.key"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  }
}
