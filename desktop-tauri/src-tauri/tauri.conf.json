{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argus",
  "version": "0.1.1",
  "identifier": "cn.argusbot.desktop",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Argus",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "resizable": true,
        "theme": "Light",
        "backgroundColor": "#f9fafb",
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; frame-src http://127.0.0.1:*",
      "devCsp": "default-src 'self' http://127.0.0.1:1420; img-src 'self' asset: data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src 'self' ws://127.0.0.1:1420 http://127.0.0.1:1420 http://127.0.0.1:* ws://127.0.0.1:*; frame-src http://127.0.0.1:*",
      "freezePrototype": true,
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "lbx154",
    "homepage": "https://github.com/lbx154/Argus",
    "shortDescription": "Argus autonomous research runtime",
    "resources": {
      "../resources/argus-backend": "argus-backend",
      "../resources/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "icon": ["icons/icon.ico"],
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3NDMzMjJCM0I2NkZEQ0QKUldUTi9XWTdLekpEaDhoWEs3YndXK2ZTbVRCcDBHSHlyanAwUjNYR3EzTkEvZFkySXpwaFlWc08K",
      "endpoints": [
        "https://github.com/lbx154/Argus/releases/latest/download/latest.json"
      ]
    }
  }
}
