# meta-layer ledger lives under a MISSION's research/ — never a repo artifact.
# resolve_project_root() resolves to the repo cwd during planner tests, so guard
# the stray write from ever being committed.
/research/
META_LEDGER.json
META_LEDGER.jsonl

