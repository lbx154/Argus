# ARGUS / FLYWHEEL server
FLYWHEEL_HOST=127.0.0.1
FLYWHEEL_PORT=8743
FLYWHEEL_DATA_DIR=./runtime
FLYWHEEL_DATABASE_PATH=./runtime/flywheel.db
FLYWHEEL_SEED_DATA_DIR=./data/seeds
FLYWHEEL_CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175

# Argus control plane. Flywheel stores only this endpoint and token-env name;
# the env reference is accepted only for this exact endpoint. Argus remains the
# single owner of provider/model/API-key configuration.
FLYWHEEL_ARGUS_BASE_URL=http://127.0.0.1:8799
FLYWHEEL_ARGUS_TOKEN_ENV=ARGUS_SKILL_WEB_TOKEN
ARGUS_SKILL_WEB_TOKEN=

# Optional source credentials. Keep these server-side.
GITHUB_TOKEN=
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# Polling defaults
FLYWHEEL_POLL_INTERVAL_SECONDS=8
FLYWHEEL_EVENT_RETENTION_DAYS=90

# Optional independent Viewer protocol adapter. It reads provider credentials from
# its own environment and must emit the JSON schema in prompts/VIEWER_PROTOCOL.md.
FLYWHEEL_VIEWER_COMMAND_JSON=
FLYWHEEL_VIEWER_TIMEOUT_SECONDS=600
FLYWHEEL_GITHUB_TOKEN_ENV=GITHUB_TOKEN
FLYWHEEL_RELEASE_GIT_TIMEOUT_SECONDS=120
