#!/usr/bin/env python3
# Check a Verus proof both ways: the file as written must pass, and each deliberately wrong variant must fail
"""verus-mutants: does the proof pass, and does it reject what it should?

  verus-mutants FILE [--mutate 'OLD=>NEW' ...] [--mutants FILE] [--verus PATH] [-- VERUS ARGS...]

Runs Verus on FILE as written, then on one copy per mutation, each with exactly one textual
replacement (OLD must occur exactly once in FILE). A mutation makes the code wrong or the claim
false, so that a sound proof must reject it: a wrong body, a flipped comparison, a dropped
`requires` the body needs, a stronger `ensures` than the code delivers. (Dropping an `ensures`
only weakens the claim; it should pass, and says nothing.) The file as written must report
0 errors; each mutant must report at least one error, or fail to compile, which is reported as such
(a mutant that does not compile proves nothing about the proof). Exit 0 only when the original
passes and every mutant is rejected by verification.

  --mutants FILE   one mutation per line, 'OLD=>NEW' (# comments and blank lines ignored)
  --verus PATH     the verus binary (default: $VERUS, else `verus` on PATH)
  --keep DIR       keep each variant and its log in DIR
  --json           the results as JSON

Each variant is verified as a sibling copy of FILE (same directory, so relative modules and
includes resolve), removed afterwards unless --keep is given. Everything after -- goes to Verus.
"""
import argparse, json, os, re, shutil, subprocess, sys, tempfile
from pathlib import Path

COUNT = re.compile(r'verification results::\s*(\d+) verified,\s*(\d+) errors?')


def run(verus, file, args):
    proc = subprocess.run([verus, str(file), *args], capture_output=True, text=True)
    out = proc.stdout + proc.stderr
    m = COUNT.findall(out)
    verified, errors = (int(m[-1][0]), int(m[-1][1])) if m else (None, None)
    first = next((l.strip() for l in out.splitlines() if l.startswith('error')), '')
    return {'exit': proc.returncode, 'verified': verified, 'errors': errors, 'first_error': first}, out


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('file')
    ap.add_argument('--mutate', action='append', default=[])
    ap.add_argument('--mutants')
    ap.add_argument('--verus', default=os.environ.get('VERUS') or shutil.which('verus'))
    ap.add_argument('--keep')
    ap.add_argument('--json', action='store_true')
    argv = sys.argv[1:]
    cut = argv.index('--') if '--' in argv else len(argv)
    a = ap.parse_args(argv[:cut])
    args = argv[cut + 1:]
    if not a.verus:
        sys.exit('no verus: pass --verus PATH or set $VERUS')
    src = Path(a.file).resolve()
    text = src.read_text()
    specs = list(a.mutate)
    if a.mutants:
        specs += [l for l in Path(a.mutants).read_text().splitlines() if l.strip() and not l.lstrip().startswith('#')]
    mutations = []
    for spec in specs:
        if '=>' not in spec:
            sys.exit(f'not OLD=>NEW: {spec!r}')
        old, new = spec.split('=>', 1)
        n = text.count(old)
        if n != 1:
            sys.exit(f'{old!r} occurs {n} times in {src.name}; make it unique')
        mutations.append((old, new))
    keep = Path(a.keep).resolve() if a.keep else None
    if keep:
        keep.mkdir(parents=True, exist_ok=True)

    results = []
    base, out = run(a.verus, src, args)
    base_ok = base['errors'] == 0 and base['exit'] == 0
    results.append({'variant': 'as written', **base, 'outcome': 'passes' if base_ok else 'FAILS'})
    if keep:
        (keep / 'original.log').write_text(out)
    for i, (old, new) in enumerate(mutations, 1):
        # Verus names the crate after the file: letters, digits and underscores only.
        fd, tmp = tempfile.mkstemp(prefix=f'{re.sub(r"\W", "_", src.stem)}_mutant{i}_', suffix=src.suffix, dir=src.parent)
        os.close(fd)
        tmp = Path(tmp)
        try:
            tmp.write_text(text.replace(old, new, 1))
            res, out = run(a.verus, tmp, args)
            if keep:
                shutil.copy(tmp, keep / f'mutant{i}{src.suffix}')
                (keep / f'mutant{i}.log').write_text(out)
        finally:
            tmp.unlink(missing_ok=True)
        if res['errors']:
            outcome = 'rejected'
        elif res['errors'] is None:
            outcome = 'DOES NOT COMPILE'
        else:
            outcome = 'NOT CAUGHT'
        results.append({'variant': f'{i}: {old.strip()[:40]} => {new.strip()[:40]}', **res, 'outcome': outcome})

    good = base_ok and all(r['outcome'] == 'rejected' for r in results[1:])
    if a.json:
        print(json.dumps({'ok': good, 'results': results}, indent=1))
    else:
        for r in results:
            counts = f"{r['verified']}/{r['errors']}" if r['errors'] is not None else 'no count'
            print(f"{r['outcome']:<28} {counts:>9}  {r['variant']}")
            if r['outcome'] != 'rejected' and r['variant'] != 'as written' or not base_ok and r['variant'] == 'as written':
                if r['first_error']:
                    print(f"{'':39}{r['first_error'][:120]}")
        print('ok: the proof passes and rejects every mutant' if good else 'NOT ok')
    sys.exit(0 if good else 1)


if __name__ == '__main__':
    main()
