  {"name":"npm legacy inline PATHEXT", "source":"@ECHO off\r\nendLocal & goto #_undefined_# 2>NUL || title %COMSPEC% & set PATHEXT=%PATHEXT:;.JS;=;% & \"%_prog%\"  \"%dp0%\\fake-agent.mjs\" %*\r\n", "target":"fake-agent.mjs", "prefix":[]},
