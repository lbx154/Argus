[
  {"name":"npm current CRLF", "source":"@ECHO off\r\nSET dp0=%~dp0\r\nendLocal & goto #_undefined_# 2>NUL || title %COMSPEC% & \"%_prog%\"  \"%dp0%\\node_modules\\cli.js\" %*\r\n", "target":"node_modules\\cli.js", "prefix":[]},
