{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schemas/resource-ledger-status.v1.json",
  "title": "ResourceStatus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enforcement",
    "accelerators"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "enforcement": {
      "enum": [
        "strict",
        "advisory"
      ]
    },
    "accelerators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResourceAcceleratorStatus"
      }
    }
  },
  "$defs": {
    "ResourceDeviceStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "total_memory_mib", "used_memory_mib", "utilization_percent"],
      "properties": {
        "index": {"type": "string"},
        "name": {"type": "string"},
        "total_memory_mib": {"type": "integer", "minimum": 0},
        "used_memory_mib": {"type": "integer", "minimum": 0},
        "utilization_percent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "ResourceAcceleratorStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "device_count",
        "detail"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "absent",
            "inaccessible",
            "degraded"
          ]
        },
        "device_count": {
          "type": "integer",
          "minimum": 0
        },
        "detail": {
          "type": "string"
        },
        "devices": {
          "type": "array",
          "items": {"$ref": "#/$defs/ResourceDeviceStatus"}
        }
      }
    }
  }
}
