{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": 2,
  "events": {
    "provider.request.started": {
      "version": 1,
      "required": [
        "provider",
        "run_label"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "run_label": {
          "type": "string"
        },
        "call_id": {
          "type": "string"
        },
        "daily_calls": {
          "type": "integer",
          "minimum": 0
        },
        "daily_cap": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provider.request.completed": {
      "version": 1,
      "required": [
        "provider",
        "run_label"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "run_label": {
          "type": "string"
        },
        "call_id": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        },
        "premium_requests": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "life.mission.completed": {
      "version": 1,
      "required": [
        "item_id",
        "status"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "park_reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "residual_risk": {
          "type": "string"
        },
        "final_output": {
          "type": "string"
        },
        "outcome_class": {
          "type": "string",
          "enum": [
            "completed",
            "incomplete",
            "stalled",
            "blocked",
            "failed",
            "ended"
          ]
        },
        "outcome": {
          "type": "object",
          "required": [
            "execution_status",
            "review_status",
            "stage_certification",
            "interruption_kind",
            "resumable"
          ],
          "properties": {
            "execution_status": {
              "type": "string"
            },
            "review_status": {
              "type": "string"
            },
            "stage_certification": {
              "type": "string"
            },
            "interruption_kind": {
              "type": "string"
            },
            "resumable": {
              "type": "boolean"
            }
          }
        },
        "success": {
          "type": "boolean"
        },
        "overall_complete": {
          "type": "boolean"
        },
        "campaign_continues": {
          "type": "boolean"
        },
        "execution_workdir": {
          "type": "string"
        },
        "delivery_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rounds": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "known_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "pricing_status": {
          "type": "string"
        },
        "research_result": {
          "type": [
            "object",
            "null"
          ]
        },
        "repair_capability": {
          "type": [
            "object",
            "null"
          ]
        },
        "stop_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "budget_exhausted",
            "cost_unreconciled",
            "provider_cooldown",
            "provider_fence",
            "daemon_shutdown",
            "operator_pause",
            "operator_abort",
            "backend_unavailable",
            "transient_error",
            "permanent_error",
            null
          ]
        },
        "recoverable": {
          "type": "boolean"
        },
        "delivery_id": {
          "type": "string"
        },
        "operator_question": {
          "type": "string"
        },
        "stop_reason": {
          "type": "string"
        },
        "failure_kind": {
          "type": "string"
        },
        "failure_cause": {
          "type": "string"
        }
      }
    },
    "life.planner.verdict": {
      "version": 1,
      "required": [
        "status",
        "success",
        "recoverable",
        "reason",
        "summary",
        "project_id",
        "mission_id"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "completed",
            "parked",
            "error",
            "research_incomplete",
            "paused_budget",
            "paused_cost",
            "paused_no_breakthrough",
            "exhausted_current_methods",
            "provider_cooldown",
            "infra_blocked"
          ],
          "description": "parked waits on park_reason. The other values after error are what older releases wrote; core/planner_verdict.py reads each as parked with its reason."
        },
        "success": {
          "type": "boolean"
        },
        "recoverable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        },
        "research_target_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "correctness_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "novelty_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "significance_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "stop_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "completion_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "park_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "delivery_id": {
          "type": "string",
          "minLength": 1
        },
        "delivery": {
          "type": [
            "object",
            "null"
          ]
        },
        "tasks_added": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "engineer.progress": {
      "version": 1,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "agent_layer": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "replace": {
          "type": "boolean"
        },
        "round_index": {
          "type": "integer",
          "minimum": 0
        },
        "experiment_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        }
      }
    },
    "life.status": {
      "version": 1,
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "ui.operator": {
      "version": 1,
      "required": [
        "message_id",
        "text"
      ],
      "properties": {
        "agent_layer": {
          "type": "string"
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "ui.argus": {
      "version": 1,
      "required": [
        "message_id",
        "text"
      ],
      "properties": {
        "turn_kind": {
          "type": "string",
          "enum": [
            "qa"
          ]
        },
        "agent_layer": {
          "type": "string"
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delivery": {
          "$ref": "#/$defs/DeliveryReceipt"
        }
      }
    }
  },
  "$defs": {
    "DeliveryTarget": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "delivery_number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "DeliveryReceipt": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "delivery_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "review_status": {
          "type": "string"
        },
        "review_source": {
          "type": "string"
        },
        "residual_risk": {
          "type": "string"
        },
        "delivered_at": {
          "type": "number",
          "minimum": 0
        },
        "primary_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeliveryTarget"
          }
        },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "stored": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
