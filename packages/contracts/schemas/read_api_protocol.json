{
  "service": "argus-read-api",
  "protocol": { "name": "argus.read-api", "major": 1, "minor": 0 },
  "bridge_protocol": "argus.read-bridge",
  "bridge_version": 2,
  "methods": ["meta", "projects", "costs", "snapshot"],
  "max_request_bytes": 65536,
  "max_response_bytes": 16777216,
  "max_cost_frame_bytes": 1048576,
  "max_cost_records": 100000,
  "max_cost_identities": 100000,
  "max_projects": 2000,
  "max_events": 500,
  "max_project_id_length": 255
}
